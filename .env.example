# Close Call settings template.
# The desktop app takes the AZURE_* lines from here and asks for the key on
# first start (setup page). The endpoint is public: it is useless without a key.
# For running server.py directly: copy to .env and add the key.
AZURE_OPENAI_ENDPOINT=https://memodo-closecall-sweden.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment names (only needed if yours differ from these defaults)
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_FEEDBACK_DEPLOYMENT=gpt-5.6-terra
AZURE_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Browser login when running server.py without desktop mode (unused by the desktop app)
USERNAME=memodo
PASSWORD=changeme
